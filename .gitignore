__pycache__/
*.pyc
.pytest_cache/
# regenerated by cad/v2/build.py for render.py
cad/v2/out/render_stl/
simulation/**/studies/results/*.err
# Launcher.cmd's logs
logs/
# cad/v7: regenerated by build.py (assembly.step is ~58 MB; it stays in the Dropbox folder)
cad/v7/out/render_stl*/
cad/v7/out/build.log
cad/v7/out/assembly.step
# cad/v8: the same (both assemblies are tens of MB; they stay in the Dropbox folder)
cad/v8/out/render_stl*/
cad/v8/out/build*.log
cad/v8/out/assembly*.step
# firmware: PlatformIO's build tree and the SIL library (rebuilt on demand by sil/build_sil.py)
firmware/.pio/
firmware/sil/build/
# v11 house scene textures (~28 MB): CC0 photos from Poly Haven, fetched by `python house_scene.py fetch` (sources,
# md5 and licence in house_scene.POLYHAVEN and the generated assets/house/SOURCES.md); the rest is made on demand
simulation/v11 sil/assets/house/
# v11 SO-101 arm meshes (~16 MB, Apache-2.0, TheRobotStudio/SO-ARM100 at a pinned commit): `python arm_so101.py fetch`
simulation/v11 sil/assets/so101/
